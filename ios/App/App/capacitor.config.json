{
	"appId": "com.vx.atelier",
	"appName": "Atelier VX",
	"webDir": "www",
	"backgroundColor": "#0B0B0C",
	"ios": {
		"contentInset": "never"
	},
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 800,
			"launchAutoHide": true,
			"backgroundColor": "#0B0B0C",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"overlaysWebView": true
		}
	},
	"packageClassList": [
		"BluetoothLe",
		"AppPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
